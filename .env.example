# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supersheet

# Server
PORT=3000
NODE_ENV=development

# Demo Mode (enables reset, switch_user, scale_inspector endpoints)
DEMO_MODE=true

# Seed Configuration
SEED_ROW_COUNT=1000000

# Pricing (demo configuration)
DEMO_PRICE_250=4999
DEMO_PRICE_1M=9999

# API Configuration
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
